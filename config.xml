<?xml version='1.0' encoding='utf-8'?>
<widget id="com.cutes.studyai" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Cute-S AI</name>
    <description>Free AI study buddy: notes, maths, coding, English and exam prep.</description>
    <author email="moonstar7023@gmail.com">iTz×͜Shahmir</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
