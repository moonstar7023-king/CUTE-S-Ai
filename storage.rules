rules_version='2';service firebase.storage{match /b/{b}/o{match /notes/{uid}/{f}{
 allow read: if request.auth!=null && (request.auth.token.email_verified==true || request.auth.token.firebase.sign_in_provider=='phone');
 allow write: if request.auth!=null && request.auth.uid==uid && request.resource.size<10*1024*1024 && request.resource.contentType.matches('application/pdf|image/.*');
 allow delete: if request.auth!=null && request.auth.uid==uid;}}}
